{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "src/frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "src/backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{test_*.py,*.db,*.log,__pycache__/**,**/__pycache__/**,src/**,tests/**,docs/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
